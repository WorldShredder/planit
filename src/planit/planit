#!/usr/bin/env bash

# shellcheck disable=SC1090,SC1091,SC2034

PLAN__PATH_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

while :; do
    case "$1" in
        -m | --modules)
            if [ ! -d "$2" ]; then
                printf '\033[31m[%-5s] %s\033[0m\n' \
                    'ERROR' "Invalid modules path '$2'"
                exit 1
            fi
            PLAN__PATH_MODULES="$2"
            shift
            ;;
        -c | --config)
            if [ ! -f "$2" ]; then
                printf '\033[31m[%-5s] %s\033[0m\n' \
                    'ERROR' "Invalid config path '$2'"
                exit 1
            fi
            PLAN__PATH_CONFIG="$2"
            shift
            ;;
        --)
            shift
            break
            ;;
        *) break ;;
    esac
    shift
done

source "${PLAN__PATH_ROOT}/planit.conf"
[ -n "$PLAN__PATH_CONFIG" ] \
    && source "$PLAN__PATH_CONFIG"
source "${PLAN__PATH_ROOT}/lib/utils.sh"
source "${PLAN__PATH_ROOT}/lib/monitor.sh"

declare -a PLAN__PID_CACHE
declare -a PLAN__FILE_CACHE

trap 'Plan::utils.exit "$?" -p PLAN__PID_CACHE -f PLAN__FILE_CACHE' \
    INT TERM HUP QUIT EXIT

if [ -n "$PLAN__LOGGING_LOGS_DIR" ]; then
    mkdir -p "$PLAN__LOGGING_LOGS_DIR" || {
        printf '\033[31m[%-5s] %s\033[0m\n' \
            'ERROR' "Failed to create dir '$PLAN__LOGGING_LOGS_DIR'"
        exit 1
    }
    PLAN__PATH_LOG="$PLAN__LOGGING_LOGS_DIR"
else
    PLAN__PATH_LOG="$(mktemp -d)"
fi
[ "$PLAN__LOGGING_KEEP_LOGS" != 'true' ] \
    && PLAN__FILE_CACHE+=("$PLAN__PATH_LOG")
PLAN__PATH_LOG_OUT="${PLAN__PATH_LOG}/out.log"
PLAN__PATH_LOG_ERR="${PLAN__PATH_LOG}/err.log"
PLAN__PATH_LOG_ALL="${PLAN__PATH_LOG}/all.log"

PLAN__PATH_FIFO="${PLAN__PATH_LOG}/fifo"
PLAN__PATH_FIFO_OUT="${PLAN__PATH_FIFO}/out"
PLAN__PATH_FIFO_ERR="${PLAN__PATH_FIFO}/err"
PLAN__FILE_CACHE+=("$PLAN__PATH_FIFO")
{
    mkdir "$PLAN__PATH_FIFO" \
        && mkfifo "$PLAN__PATH_FIFO_OUT" \
        && mkfifo "$PLAN__PATH_FIFO_ERR"
} || {
    printf '\033[31m[%-5s] %s\033[0m\n' 'ERROR' 'Failed to created fifo'
    exit 1
}

# Error handler will reset cursor and alt screens
tput civis

for module in "${PLAN__PATH_MODULES[@]}"/*; do
    # Listeners
    tee -a "$PLAN__PATH_LOG_ALL" > "$PLAN__PATH_LOG_OUT" < "$PLAN__PATH_FIFO_OUT" &
    PLAN__PID_CACHE+=("$!")
    tee -a "$PLAN__PATH_LOG_ALL" > "$PLAN__PATH_LOG_ERR" < "$PLAN__PATH_FIFO_ERR" &
    PLAN__PID_CACHE+=("$!")

    PLAN__MODULE_TITLE='Running Process'
    PLAN__IGNORE_CODES=''

    # Source in subshell to maintain clean environment in parent
    (
        [ -f "${module}/planit.conf" ] \
            && source "${module}/planit.conf"
        [ -f "${module}/start.sh" ] \
            && module="${module}/start.sh"

        /usr/bin/env bash "$module" \
            1> "$PLAN__PATH_FIFO_OUT" \
            2> "$PLAN__PATH_FIFO_ERR" &

        # monitor.run propagates the module's exit code
        Plan::monitor.run "$!" "$PLAN__PATH_LOG_OUT"
        exit_code="$?"

        ! Plan::utils.ok -i "$PLAN__IGNORE_CODES" "$exit_code" \
            && exit "$exit_code"

        printf '%b%s %b%s\033[0m\n' \
            "$PLAN__COLOR_STEP_OK" "$PLAN__ICON_STEP_OK" \
            "$PLAN__COLOR_STEP_TITLE" "$PLAN__MODULE_TITLE"
    )
done

exit 0
